{
  "name": "sheetedit",
  "version": "0.1.0",
  "description": "Standalone client-side spreadsheet editor for .xlsx and .ods: edit cells and formulas in a grid and export a valid workbook, preserving styles and other parts, all in the browser.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run css && tsc -p tsconfig.json",
    "build:demo": "vite build",
    "typecheck": "node node_modules/tsgo/bin/tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:demo && start-server-and-test 'vite preview --port 5173 --strictPort' http://localhost:5173 'cypress run --browser chrome'",
    "prepare": "npm run css && tsc -p tsconfig.json",
    "css": "node scripts/build-css.mjs",
    "css:check": "node scripts/build-css.mjs --check",
    "check:schema": "vitest run src/adapters/xlsx/schema-corpus.test.ts && node scripts/schema-check.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "emf-converter": "^2.0.2",
    "fast-formula-parser": "^1.0.19",
    "fflate": "^0.8.2",
    "localml": "github:hikashop-nicolas/localml",
    "mlang": "github:hikashop-nicolas/mlang",
    "vbalang": "github:hikashop-nicolas/vbalang"
  },
  "devDependencies": {
    "cypress": "^15.17.0",
    "jsdom": "^28.0.0",
    "start-server-and-test": "^3.0.11",
    "tsgo": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
